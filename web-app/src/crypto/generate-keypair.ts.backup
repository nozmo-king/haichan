#!/usr/bin/env node

/**
 * secp256k1 Keypair Generator
 * 
 * Generates secp256k1 private/public key pairs using the well-tested @noble/secp256k1 library.
 * 
 * Usage:
 *   npm run generate-keypair [count]
 *   npx tsx src/crypto/generate-keypair.ts [count]
 */

import { secp256k1 } from '@noble/secp256k1';
import { randomBytes } from 'crypto';

export interface Keypair {
  privateKey: string;
  publicKey: string;
}

export interface KeypairGeneratorOptions {
  count?: number;
  format?: 'hex' | 'base64';
  compress?: boolean;
}

/**
 * Secure secp256k1 keypair generator using the @noble/secp256k1 library
 */
export class SecureKeypairGenerator {
  private static readonly DEFAULT_OPTIONS: Required<KeypairGeneratorOptions> = {
    count: 1,
    format: 'hex',
    compress: true
  };

  /**
   * Generate a single cryptographically secure keypair
   */
  static generateKeypair(options: Partial<KeypairGeneratorOptions> = {}): Keypair {
    const opts = { ...this.DEFAULT_OPTIONS, ...options };
    
    try {
      // Generate cryptographically secure private key
      const privateKeyBytes = this.generateSecurePrivateKey();
      const privateKey = this.formatKey(privateKeyBytes, opts.format);
      
      // Generate public key using noble library
      const publicKeyPoint = secp256k1.getPublicKey(privateKeyBytes, opts.compress);
      const publicKey = this.formatKey(publicKeyPoint, opts.format);
      
      return { privateKey, publicKey };
    } catch (error) {
      throw new Error(`Failed to generate keypair: ${error instanceof Error ? error.message : 'Unknown error'}`);
    }
  }

  /**
   * Generate multiple keypairs
   */
  static generateKeypairs(count: number, options: Partial<KeypairGeneratorOptions> = {}): Keypair[] {
    this.validateCount(count);
    
    const keypairs: Keypair[] = [];
    for (let i = 0; i < count; i++) {
      keypairs.push(this.generateKeypair(options));
    }
    
    return keypairs;
  }

  /**
   * Verify that a private key generates the expected public key
   */
  static verifyKeypair(privateKey: string, publicKey: string, format: 'hex' | 'base64' = 'hex'): boolean {
    try {
      const privateKeyBytes = format === 'hex' 
        ? Buffer.from(privateKey, 'hex')
        : Buffer.from(privateKey, 'base64');
      
      const expectedPublicKey = secp256k1.getPublicKey(privateKeyBytes, true);
      const expectedPublicKeyString = this.formatKey(expectedPublicKey, format);
      
      return expectedPublicKeyString === publicKey;
    } catch {
      return false;
    }
  }

  /**
   * Generate a cryptographically secure private key
   */
  private static generateSecurePrivateKey(): Uint8Array {
    let privateKey: Uint8Array;
    
    do {
      privateKey = randomBytes(32);
    } while (!secp256k1.utils.isValidPrivateKey(privateKey));
    
    return privateKey;
  }

  /**
   * Format key bytes as hex or base64
   */
  private static formatKey(keyBytes: Uint8Array, format: 'hex' | 'base64'): string {
    const buffer = Buffer.from(keyBytes);
    return format === 'hex' ? buffer.toString('hex') : buffer.toString('base64');
  }

  /**
   * Validate count parameter
   */
  private static validateCount(count: number): void {
    if (!Number.isInteger(count) || count < 1 || count > 100) {
      throw new Error('Count must be an integer between 1 and 100');
    }
  }
}

/**
 * CLI Interface
 */
class KeypairCLI {
  static async run(): Promise<void> {
    try {
      console.log('🔐 Secure secp256k1 Keypair Generator');
      console.log('====================================\n');
      
      const args = process.argv.slice(2);
      const count = this.parseCount(args[0]);
      
      const keypairs = SecureKeypairGenerator.generateKeypairs(count);
      
      this.displayKeypairs(keypairs);
      this.displayInstructions();
      
    } catch (error) {
      console.error(`❌ Error: ${error instanceof Error ? error.message : 'Unknown error'}`);
      this.displayUsage();
      process.exit(1);
    }
  }

  private static parseCount(arg?: string): number {
    if (!arg) return 1;
    
    const count = parseInt(arg, 10);
    if (isNaN(count) || count < 1 || count > 100) {
      throw new Error('Invalid count. Please specify a number between 1 and 100.');
    }
    
    return count;
  }

  private static displayKeypairs(keypairs: Keypair[]): void {
    keypairs.forEach((keypair, index) => {
      console.log(`Keypair ${index + 1}:`);
      console.log(`Private Key: ${keypair.privateKey}`);
      console.log(`Public Key:  ${keypair.publicKey}`);
      
      // Verify the keypair
      const isValid = SecureKeypairGenerator.verifyKeypair(
        keypair.privateKey, 
        keypair.publicKey
      );
      
      if (!isValid) {
        throw new Error(`Keypair ${index + 1} failed validation`);
      }
      
      console.log('✅ Verified\n');
    });
  }

  private static displayInstructions(): void {
    console.log('✅ All keypairs generated successfully!\n');
    console.log('📋 Usage Instructions:');
    console.log('1. Copy the Public Key to the admin panel at /admin/keys');
    console.log('2. Securely transmit the Private Key to the user');
    console.log('3. User enters the Private Key in the login form\n');
    console.log('⚠️  Security Notes:');
    console.log('• Private keys should be transmitted through secure channels');
    console.log('• Users should store private keys in secure password managers');
    console.log('• Lost private keys cannot be recovered');
    console.log('• Never share private keys in plain text or insecure channels');
  }

  private static displayUsage(): void {
    console.log('\nUsage:');
    console.log('  npm run generate-keypair [count]');
    console.log('  npx tsx src/crypto/generate-keypair.ts [count]');
    console.log('\nExamples:');
    console.log('  npm run generate-keypair     # Generate 1 keypair');
    console.log('  npm run generate-keypair 5   # Generate 5 keypairs');
  }
}

// Run CLI if this file is executed directly
if (require.main === module) {
  KeypairCLI.run().catch((error) => {
    console.error('Fatal error:', error);
    process.exit(1);
  });
}

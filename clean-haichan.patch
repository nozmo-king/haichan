*** Add File: app/Http/Middleware/SkeletonKey.php
+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Auth;
+
+class SkeletonKey
+{
+    public function handle(Request $request, Closure $next)
+    {
+        if (!filter_var(env('SKELETON_ENABLED', false), FILTER_VALIDATE_BOOL)) {
+            return $next($request);
+        }
+
+        $provided = $request->header('X-Skeleton-Key')
+            ?? $request->cookie('skeleton_key')
+            ?? $request->query('key')
+            ?? $request->input('key');
+
+        if (!$provided) return $next($request);
+
+        $allowed = collect(explode(',', (string) env('SKELETON_KEYS', '')))
+            ->map(fn($s) => trim($s))
+            ->filter();
+
+        if ($allowed->contains($provided)) {
+            session(['skeleton' => [
+                'granted_at' => now()->toIso8601String(),
+                'scope' => env('SKELETON_SCOPE', 'read-only'),
+            ]]);
+
+            if (!Auth::check()) {
+                $user = \App\Models\User::firstOrCreate(
+                    ['email' => 'skeleton@haichan.local'],
+                    ['name' => 'skeleton', 'role' => 'skeleton']
+                );
+                Auth::login($user, false);
+            }
+
+            cookie()->queue(cookie(
+                'skeleton_key', $provided,
+                env('SKELETON_SESSION_TTL',7200)/60,
+                null, null, true, true, false, 'Lax'
+            ));
+        }
+
+        return $next($request);
+    }
+}
+
